ARG DO_AGENT_VERSION
ARG DO_AGENT_IMAGE=invalid.invalid/doagent-image-must-be-specified
ARG BUILDKIT_IMAGE=moby/buildkit:v0.21.1@sha256:c3d76ba1fddb719901873a54cee941fb6c794b431ed36c71c6506ea401e78fdb
ARG KUBECTL_VERSION=v1.33.1
ARG HELM_VERSION=v3.14.4

# Lightweight base image for doops-agent runtime.
#
# Goal:
# - keep do-agent + canonical skills
# - keep buildkit/buildctl
# - keep tini/bash/git/curl/ca-certificates/procps/psmisc
# - avoid inheriting legacy WebIDE/SSH startup behavior as a default runtime
FROM ${BUILDKIT_IMAGE} AS buildkit

FROM ${DO_AGENT_IMAGE}

ARG DO_AGENT_VERSION
ARG BUILDKIT_IMAGE
ARG KUBECTL_VERSION
ARG HELM_VERSION

USER root

LABEL org.l8ai.doagent.version="${DO_AGENT_VERSION}"
LABEL org.l8ai.buildkit.image="${BUILDKIT_IMAGE}"

COPY --from=buildkit /usr/bin/buildctl /usr/local/bin/buildctl
COPY --from=buildkit /usr/bin/buildkit* /usr/local/bin/

RUN test "$(/usr/local/bin/do-agent --version)" = "do-agent ${DO_AGENT_VERSION}" \
    && /usr/local/bin/do-agent --help >/dev/null \
    && if command -v apt-get >/dev/null 2>&1; then \
        apt-get update \
        && apt-get install -y --no-install-recommends bash ca-certificates curl git tini procps psmisc python3 python3-yaml \
        && { apt-get purge -y --auto-remove openssh-server openssh-client rsync sudo || true; } \
        && rm -rf /var/lib/apt/lists/*; \
      elif command -v apk >/dev/null 2>&1; then \
        apk add --no-cache bash ca-certificates curl git tini procps psmisc python3 py3-yaml \
        && { apk del openssh-server openssh-client rsync sudo 2>/dev/null || true; }; \
      fi \
    && if ! command -v kubectl >/dev/null 2>&1; then \
        ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/'); \
        curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${ARCH}/kubectl" -o /usr/local/bin/kubectl \
        && chmod +x /usr/local/bin/kubectl; \
      fi \
    && ARCH=$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/'); \
      curl -fsSL "https://get.helm.sh/helm-${HELM_VERSION}-linux-${ARCH}.tar.gz" -o /tmp/helm.tar.gz \
      && tar -xzf /tmp/helm.tar.gz -C /tmp \
      && mv "/tmp/linux-${ARCH}/helm" /usr/local/bin/helm \
      && chmod +x /usr/local/bin/helm \
      && rm -rf /tmp/helm.tar.gz "/tmp/linux-${ARCH}" \
    && kubectl version --client=true \
    && buildctl --version \
    && python3 --version \
    && python3 -c 'import yaml' \
    && helm version --short \
    && rm -f /usr/local/bin/start-webide.sh /entrypoint.sh /usr/bin/entrypoint.sh /init.sh
