[Unit]
Description=Verify and refresh the approved DoOps inspection advisory feed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=doops-advisories
Group=doops-inspection
StateDirectory=doops-advisories
StateDirectoryMode=0750
Environment=INSPECTION_EVIDENCE_ROOT=/var/lib/doops-advisories
EnvironmentFile=/etc/doops/inspection/advisories.env
ExecStart=/usr/bin/python3 /opt/doops/inspection/advisory_sync.py
TimeoutStartSec=90s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
